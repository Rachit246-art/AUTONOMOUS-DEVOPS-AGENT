# ==============================================================================
# Autonomous DevOps Agent - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and save it as '.env' in the project root directory.
# 2. Populate the variables below with your database credentials and LLM settings.
# 3. DO NOT commit or push your actual '.env' file or private API keys to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Microsoft SQL Server)
# ------------------------------------------------------------------------------
# Hostname or IP address of your SQL Server instance (e.g., localhost or 127.0.0.1)
DB_SERVER=localhost

# Database name (e.g., DevOpsAgentDB)
DB_NAME=DevOpsAgentDB

# Name of the installed ODBC driver on your system
DB_DRIVER=ODBC Driver 18 for SQL Server

# Set to 'yes' for Windows Authentication / Trusted Connection, or specify SQL user/pass
DB_TRUSTED_CONNECTION=yes

# ------------------------------------------------------------------------------
# 2. LLM API & Router Configuration
# ------------------------------------------------------------------------------
# Full API endpoint URL for chat completions (e.g., OpenAI, custom LLM router endpoint)
API_URL=https://your-llm-router-api-url/v2/chat/completions

# Private API authorization key (bearer token or X-API-KEY required by your provider)
API_KEY=your_api_key_here

# Target LLM model name (e.g., gpt-5-chat, gpt-4o, llama-3.3-70b)
MODEL_NAME=gpt-5-chat

# ------------------------------------------------------------------------------
# 3. RAG & Vector Store Configuration
# ------------------------------------------------------------------------------
# Maximum distance / similarity cutoff threshold for context retrieval (optional)
RAG_MAX_DISTANCE=
