# ==============================================================================
# Autonomous DevOps Agent - Environment Configuration Template
# Copy this file to .env and configure local secrets and parameters.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Autonomous DevOps Agent"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Microsoft SQL Server Database Configuration
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=autonomous_devops_db
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes
# SQLAlchemy Connection String format:
# mssql+pyodbc://<user>:<password>@<server>:<port>/<db>?driver=<driver>&TrustServerCertificate=yes
DATABASE_URL=mssql+pyodbc://sa:YourStrongPassword123!@localhost:1433/autonomous_devops_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Vector Store / RAG Configuration
CHROMA_PERSIST_DIRECTORY=./data/vector_db
DATA_DOCUMENTS_DIRECTORY=./data/documents
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Future LLM Integrations (Placeholders)
GROQ_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Future DevOps Orchestration Integrations (Placeholders)
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
GITHUB_TOKEN=
